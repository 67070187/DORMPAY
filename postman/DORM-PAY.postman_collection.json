        "type": "text/javascript",
        "exec": [
          "// ตั้งค่าเดือนปัจจุบัน (YYYY-MM) ให้อัตโนมัติ",
          "if (!pm.collectionVariables.get(\"month\")) {",
          "  const d = new Date();",
          "  pm.collectionVariables.set(\"month\", `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}`);",
          "}"
        ]
      }
    }
  ],
