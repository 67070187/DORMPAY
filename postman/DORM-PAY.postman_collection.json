      "name": "4. Meters → Bills → Pay",
      "item": [
        {
          "name": "Get meters (เดือนนี้)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meters?month={{month}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meters"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "{{month}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const room = pm.response.json().rooms.find((r) => r.roomNumber === \"102\");",
                  "pm.collectionVariables.set(\"waterPrev\", room.waterPrev);",
                  "pm.collectionVariables.set(\"elecPrev\", room.elecPrev);",
                  "pm.collectionVariables.set(\"waterNext\", room.waterPrev + 5);",
                  "pm.collectionVariables.set(\"elecNext\", room.elecPrev + 100);"
                ]
              }
            }
          ]
        },
        {
          "name": "Save meters → ออกบิลห้อง 102",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/meters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meters"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"month\": \"{{month}}\",\n  \"readings\": [\n    {\n      \"roomId\": 2,\n      \"waterPrev\": \"{{waterPrev}}\",\n      \"waterCurr\": \"{{waterNext}}\",\n      \"elecPrev\": \"{{elecPrev}}\",\n      \"elecCurr\": \"{{elecNext}}\"\n    }\n  ]\n}",
              "options": {
