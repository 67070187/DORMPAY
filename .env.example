# ฐานข้อมูล MySQL (ตรงกับ docker-compose.yml)
DATABASE_URL="mysql://root:root@localhost:3307/dormpay"

# ใช้เซ็น session cookie (สุ่มข้อความยาวๆ ใส่ได้เลย)
AUTH_SECRET="change-me-to-a-long-random-string"

# URL ของเว็บ ใช้สร้างลิงก์กลับจาก Stripe
APP_URL="http://localhost:3000"

# Stripe test keys จาก https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# (ไม่บังคับ) ได้จาก `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""
